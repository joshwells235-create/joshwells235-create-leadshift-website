---
// The concept's FAQ rows: <details> with the plus-in-circle that turns into a filled navy cross.
// Pass the same items to the layout's `faq` prop so the structured data matches what's shown.
interface Item { q: string; a: string; link?: [string, string] }
interface Props { items: Item[]; openFirst?: boolean; heading?: 'h3' | 'h4' }
const { items, openFirst = true, heading = 'h3' } = Astro.props;
const H = heading;
---
<div class="qa" data-reveal style="--d:1">
  {items.map((it, i) => (
    <details open={openFirst && i === 0}>
      <summary><H>{it.q}</H><i class="pm" aria-hidden="true"></i></summary>
      <div class="a">
        <p>{it.a}</p>
        {it.link && <a class="textlink" href={it.link[1]}>{it.link[0]}<svg aria-hidden="true"><use href="#arrow" /></svg></a>}
      </div>
    </details>
  ))}
</div>
